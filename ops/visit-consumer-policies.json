[
  {
    "name": "shortlink-visit-consumer",
    "pattern": "^shortlink\\.visit\\.stats\\.q$",
    "apply-to": "queues",
    "priority": 20,
    "definition": {
      "dead-letter-exchange": "shortlink.visit.dlx",
      "dead-letter-routing-key": "visit.failed.v1",
      "max-length": 10000,
      "max-length-bytes": 16777216,
      "message-ttl": 86400000,
      "overflow": "reject-publish"
    }
  },
  {
    "name": "shortlink-visit-dead-letter",
    "pattern": "^shortlink\\.visit\\.stats\\.dlq$",
    "apply-to": "queues",
    "priority": 20,
    "definition": {
      "max-length": 1000,
      "max-length-bytes": 4194304,
      "message-ttl": 86400000,
      "overflow": "drop-head"
    }
  }
]
